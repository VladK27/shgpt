#!/usr/bin/env python3
"""shgpt: natural-language bash command generator.

Expects:
  SHGPT_API_KEY   OpenAI-compatible API key
  SHGPT_API_URL   optional, default https://api.deepseek.com/chat/completions
  SHGPT_MODEL     optional, default deepseek-chat
"""
import itertools
import json
import os
import subprocess
import sys
import threading
import time
from urllib.error import HTTPError
from urllib.request import Request, urlopen


def _spinner(stop: threading.Event) -> None:
    frames = itertools.cycle(["⣾", "⣽", "⣻", "⢿", "⡿", "⣟", "⣯", "⣷"])
    while not stop.is_set():
        sys.stdout.write(f"\r{next(frames)}")
        sys.stdout.flush()
        time.sleep(0.1)
    sys.stdout.write("\r \r")
    sys.stdout.flush()


def generate_command(query: str) -> str:
    api_key = os.environ.get("SHGPT_API_KEY")
    if not api_key:
        print("error: set SHGPT_API_KEY", file=sys.stderr)
        sys.exit(1)

    url = os.environ.get("SHGPT_API_URL", "https://api.deepseek.com/chat/completions")
    model = os.environ.get("SHGPT_MODEL", "deepseek-chat")

    prompt = (
        f"Напиши одну bash-команду для запроса: {query}\n"
        "Ответь только командой, без пояснений, без markdown."
    )

    req = Request(
        url,
        data=json.dumps({
            "model": model,
            "messages": [{"role": "user", "content": prompt}],
            "temperature": 0,
        }).encode(),
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {api_key}",
        },
        method="POST",
    )

    stop = threading.Event()
    spinner = threading.Thread(target=_spinner, args=(stop,))
    spinner.start()
    try:
        with urlopen(req) as resp:
            data = json.load(resp)
    except HTTPError as e:
        if e.code == 401:
            print("error: invalid or missing API key (check SHGPT_API_KEY)", file=sys.stderr)
            sys.exit(1)
        raise
    finally:
        stop.set()
        spinner.join()

    return data["choices"][0]["message"]["content"].strip().strip("`").strip()


def main() -> None:
    if len(sys.argv) < 2:
        print("usage: shgpt <описание команды>", file=sys.stderr)
        sys.exit(1)

    query = " ".join(sys.argv[1:])
    command = generate_command(query)

    print(f"$ {command}")
    answer = input("Execute? [y/N] ").strip().lower()
    if answer == "y":
        # ponytail: shell=True is required for pipelines/redirects; user confirms first
        subprocess.run(command, shell=True)
    else:
        print("cancelled")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\ncancelled", file=sys.stderr)
        sys.exit(130)
